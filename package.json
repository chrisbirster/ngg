{
  "name": "ngg",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "dev:api": "go run ./cmd/ngg",
    "typecheck": "tsc --noEmit",
    "test": "go test ./...",
    "build:web": "vite build",
    "build:server": "CGO_ENABLED=0 go build -trimpath ./cmd/ngg",
    "verify": "pnpm typecheck && pnpm build:web && pnpm test && pnpm build:server"
  },
  "dependencies": {
    "@solidjs/router": "next",
    "@solidjs/web": "next",
    "@stylexjs/stylex": "0.19.0",
    "solid-js": "next"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "next",
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
